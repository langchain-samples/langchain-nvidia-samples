# Copy this file to .env and fill in values locally. Never commit .env.

# NVIDIA Nemotron through hosted or self-hosted NIM.
MODEL_PROVIDER=nvidia
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
# Optional. A custom endpoint also needs a matching OpenShell network-policy entry.
NVIDIA_BASE_URL=
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=8192

# LangSmith tracing from the agent process inside OpenShell.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=openshell-contained-agent-workshop
LANGSMITH_API_KEY=
LANGCHAIN_CALLBACKS_BACKGROUND=false
LANGSMITH_OUTPUT_PREVIEW_CHARS=1000

# OpenShell.
OPENSHELL_SANDBOX_NAME=contained-agent-workshop
OPENSHELL_DEFAULT_TIMEOUT_SECONDS=1800
