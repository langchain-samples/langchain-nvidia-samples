# Copy this file to .env and fill in values locally.
# Do not commit .env.

# Model provider. The workshop default is NVIDIA NIM.
MODEL_PROVIDER=nvidia
# Default workshop model: NVIDIA Nemotron 3 Ultra 550B-A55B through NIM.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
# Optional. Set this when pointing ChatNVIDIA at a self-hosted NIM endpoint.
NVIDIA_BASE_URL=

# LangSmith tracing.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=openshell-deepagents-langsmith-workshop
LANGSMITH_API_KEY=
# Keep notebook trace links available immediately after each lab cell finishes.
LANGCHAIN_CALLBACKS_BACKGROUND=false
# Keep command-output previews small. Set to 0 to omit output previews from
# custom OpenShell spans while preserving exit codes and file paths.
LANGSMITH_OUTPUT_PREVIEW_CHARS=1000

# OpenShell.
# Recommended: create this sandbox once before the workshop and reuse it.
OPENSHELL_SANDBOX_NAME=workshop-sandbox
OPENSHELL_DEFAULT_TIMEOUT_SECONDS=1800
